<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.UserMapper">

    <!-- 通用列清单：避免 SELECT *，只取需要的列；新增字段时只需改这一处 -->
    <sql id="BaseColumns">
        id, username, password, nickname, avatar, created_at, updated_at
    </sql>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(*)
        FROM `user`
        WHERE username = #{username}
    </select>

    <select id="findByUsername" resultType="User">
        SELECT
        <include refid="BaseColumns"/>
        FROM `user`
        WHERE username = #{username}
    </select>

    <select id="findById" resultType="User">
        SELECT
        <include refid="BaseColumns"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM `user`
    </select>

    <!-- useGeneratedKeys + keyProperty：插入后把自增主键回填到 user.id -->
    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, nickname, avatar)
        VALUES (#{username}, #{password}, #{nickname}, #{avatar})
    </insert>

</mapper>
